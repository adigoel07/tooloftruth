{
  "$schema": "https://tooloftruth.dev/schemas/receipt-v1.json",
  "title": "Tool of Truth Receipt Schema",
  "description": "Schema for verification receipts generated by Tool of Truth",
  "type": "object",
  "required": ["version", "id", "timestamp", "tooloftruthVersion", "agent", "target", "calls", "sessionSummary", "receiptHash"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^rcpt_" },
    "timestamp": { "type": "string", "format": "date-time" },
    "tooloftruthVersion": { "type": "string" },
    "agent": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "sessionId": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["mcp", "cli", "npm", "pip", "skill"] },
        "installed": { "type": "boolean" },
        "configured": { "type": "boolean" }
      }
    },
    "calls": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolCall" }
    },
    "sessionSummary": {
      "type": "object",
      "properties": {
        "totalCalls": { "type": "integer" },
        "verified": { "type": "integer" },
        "fabricated": { "type": "integer" },
        "suspicious": { "type": "integer" },
        "totalCostUsd": { "type": "number" },
        "totalTokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer" },
            "output": { "type": "integer" }
          }
        },
        "avgTrustScore": { "type": "integer" }
      }
    },
    "receiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "toolCall": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "tool": { "type": "string" },
        "server": { "type": "string" },
        "sessionId": { "type": "string" },
        "userPrompt": { "type": "string" },
        "durationMs": { "type": "integer" },
        "isError": { "type": "boolean" },
        "tokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer" },
            "output": { "type": "integer" }
          }
        },
        "costUsd": { "type": "number" },
        "verification": {
          "type": "object",
          "properties": {
            "schemaValid": { "type": "boolean" },
            "responsePlausible": { "type": "boolean" },
            "trustScore": { "type": "integer" },
            "verdict": { "type": "string", "enum": ["VERIFIED", "SUSPICIOUS", "FABRICATION"] },
            "fabricationConfidence": { "type": "number" },
            "checksPerformed": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
